# ===========================================================================
# StudySpace — environment variables
# Copy to `.env` (backend) and `.env.local` (frontend) and fill in real values.
# `.env*` is git-ignored EXCEPT this example. NEVER commit real secrets.
# ===========================================================================

# ---------------------------------------------------------------------------
# FRONTEND (apps/web) — public values only, safe to ship in the bundle.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The Supabase "anon"/publishable key. Protected by Row Level Security.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Base URL of the StudySpace API. In dev the Vite proxy forwards /api to :8787.
VITE_API_BASE_URL=/api/v1

# DO NOT put the service-role key, Google client secret or refresh token here.
# Anything prefixed VITE_ is embedded in the browser bundle.

# ---------------------------------------------------------------------------
# BACKEND (apps/api) — server-only secrets. Never exposed to the browser.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8787

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Bypasses RLS. Used only inside the API. NEVER ship this to a client.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# The anon/publishable key. PUBLIC — the API serves it to the browser via
# GET /api/v1/config so the frontend needs no build-time secrets.
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google Drive — the single central owner account that stores all files.
# OPTIONAL at boot: without these the server still starts and serves the app,
# and file features are disabled with a clear message until you add them.
GOOGLE_CLIENT_ID=YOUR-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR-CLIENT-SECRET
GOOGLE_REDIRECT_URI=http://localhost:8787/api/v1/oauth/google/callback
# Long-lived refresh token minted ONCE by the owner (see docs/SETUP.md).
GOOGLE_REFRESH_TOKEN=YOUR-REFRESH-TOKEN
# The Drive folder that holds every uploaded file.
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR-DRIVE-FOLDER-ID

# CORS: the exact origin(s) of the deployed frontend (comma-separated).
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# TESTING (optional)
# ---------------------------------------------------------------------------
# E2E_BASE_URL=http://localhost:5173
# SUPABASE_TEST_URL=
# SUPABASE_TEST_SERVICE_ROLE_KEY=
# GOOGLE_TEST_FOLDER_ID=
